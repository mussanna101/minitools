// ===== 3. JavaScript Playground =====
export function JSPlayground() {
  const [code, setCode] = useState(`// Enter JavaScript code here
const numbers = [1, 2, 3, 4, 5];
const doubled = numbers.map(n => n * 2);
console.log('Doubled:', doubled);

function greet(name) {
  return 'Hello, ' + name + '!';
}
console.log(greet('World'));`);
  const [output, setOutput] = useState('');
  const [error, setError] = useState('');

  const run = () => {
    setOutput('');
    setError('');
    const logs = [];
    const originalLog = console.log;
    console.log = (...args) => {
      logs.push(args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' '));
    };
    try {
      new Function(code)();
      setOutput(logs.join('\n'));
    } catch (e) {
      setError(e.message);
    } finally {
      console.log = originalLog;
    }
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-sm font-medium mb-1">JavaScript Code</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={code} onChange={(e) => setCode(e.target.value)} placeholder="Enter JavaScript code..." />
        </div>
        <div>
          <label className="block text-sm font-medium mb-1">Output</label>
          <div className="border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-900 text-green-400 min-h-[300px] p-4 font-mono text-sm overflow-auto">
            {output && <pre className="whitespace-pre-wrap">{output}</pre>}
            {error && <pre className="text-red-400 whitespace-pre-wrap">{error}</pre>}
            {!output && !error && <span className="text-gray-500">Run code to see output...</span>}
          </div>
        </div>
      </div>
      <div className="flex gap-2">
        <button onClick={run} className="btn-primary flex-1">Run Code</button>
        <CopyButton text={code} />
      </div>
    </div>
  );
}

// ===== 4. HTML to JSX Converter =====
export function HTMLToJSX() {
  const [html, setHtml] = useState(`<div class="container">
  <h1>Hello World</h1>
  <p class="text">This is a paragraph</p>
  <img src="image.jpg" alt="Image">
  <input type="text" placeholder="Enter text">
  <button onclick="handleClick()">Click</button>
</div>`);
  const [jsx, setJsx] = useState('');

  const convert = () => {
    let result = html
      .replace(/\bclass=/g, 'className=')
      .replace(/\bfor=/g, 'htmlFor=')
      .replace(/\bonclick=/g, 'onClick=')
      .replace(/\bonchange=/g, 'onChange=')
      .replace(/\bonsubmit=/g, 'onSubmit=')
      .replace(/\bonload=/g, 'onLoad=')
      .replace(/\bonfocus=/g, 'onFocus=')
      .replace(/\bonblur=/g, 'onBlur=')
      .replace(/\bonkeydown=/g, 'onKeyDown=')
      .replace(/\bonkeyup=/g, 'onKeyUp=')
      .replace(/\bonmouseover=/g, 'onMouseOver=')
      .replace(/\bonmouseout=/g, 'onMouseOut=')
      .replace(/<img([^>]*)\/?>/g, '<img$1 />')
      .replace(/<input([^>]*)\/?>/g, '<input$1 />')
      .replace(/<br([^>]*)\/?>/g, '<br$1 />')
      .replace(/<hr([^>]*)\/?>/g, '<hr$1 />')
      .replace(/\btabindex=/g, 'tabIndex=')
      .replace(/\bmaxlength=/g, 'maxLength=')
      .replace(/\breadonly/g, 'readOnly')
      .replace(/\bautofocus/g, 'autoFocus')
      .replace(/\bautocomplete=/g, 'autoComplete=')
      .replace(/\bspellcheck=/g, 'spellCheck=')
      .replace(/\bcontenteditable=/g, 'contentEditable=')
      .replace(/\bsrcdoc=/g, 'srcDoc=')
      .replace(/\bframeborder=/g, 'frameBorder=')
      .replace(/\ballowfullscreen/g, 'allowFullScreen')
      .replace(/\bcellpadding=/g, 'cellPadding=')
      .replace(/\bcellspacing=/g, 'cellSpacing=')
      .replace(/\bcolspan=/g, 'colSpan=')
      .replace(/\browspan=/g, 'rowSpan=')
      .replace(/\bstroke-width=/g, 'strokeWidth=')
      .replace(/\bfill-opacity=/g, 'fillOpacity=')
      .replace(/\bstroke-opacity=/g, 'strokeOpacity=')
      .replace(/\bstroke-linecap=/g, 'strokeLinecap=')
      .replace(/\bstroke-linejoin=/g, 'strokeLinejoin=')
      .replace(/\bstroke-dasharray=/g, 'strokeDasharray=')
      .replace(/\bstroke-dashoffset=/g, 'strokeDashoffset=')
      .replace(/\bclip-path=/g, 'clipPath=')
      .replace(/\bclip-rule=/g, 'clipRule=')
      .replace(/\bfill-rule=/g, 'fillRule=')
      .replace(/\bstop-color=/g, 'stopColor=')
      .replace(/\bstop-opacity=/g, 'stopOpacity=')
      .replace(/\bxlink:href=/g, 'xlinkHref=')
      .replace(/\bxml:space=/g, 'xmlSpace=')
      .replace(/\bxml:lang=/g, 'xmlLang=')
      .replace(/\bxml:base=/g, 'xmlBase=')
      .replace(/style="([^"]*)"/g, (match, style) => {
        const styleObj = style.split(';').filter(s => s.trim()).map(s => {
          const [prop, val] = s.split(':').map(x => x.trim());
          const camelProp = prop.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
          return `${camelProp}: '${val}'`;
        }).join(', ');
        return `style={{ ${styleObj} }}`;
      });
    setJsx(result);
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-sm font-medium mb-1">HTML Code</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={html} onChange={(e) => setHtml(e.target.value)} placeholder="Enter HTML code..." />
        </div>
        <div>
          <label className="block text-sm font-medium mb-1">JSX Output</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={jsx} readOnly placeholder="Converted JSX appears here..." />
        </div>
      </div>
      <div className="flex gap-2">
        <button onClick={convert} className="btn-primary flex-1">Convert to JSX</button>
        <CopyButton text={jsx} />
      </div>
    </div>
  );
}

// ===== 5. CSS to SCSS Converter =====
export function CSSToSCSS() {
  const [css, setCss] = useState(`.container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background-color: #f0f0f0;
}

.container .title {
  font-size: 24px;
  color: #333;
}

.container .button {
  background-color: blue;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
}`);
  const [scss, setScss] = useState('');

  const convert = () => {
    const lines = css.split('\n');
    const result = [];
    const indentStack = [];
    let currentIndent = 0;

    lines.forEach(line => {
      const trimmed = line.trim();
      if (!trimmed) return;
      const indent = line.match(/^\s*/)[0].length;
      const isSelector = trimmed.includes('{');
      const isClosing = trimmed.includes('}');

      if (isClosing) {
        indentStack.pop();
        return;
      }

      if (isSelector) {
        const selector = trimmed.replace('{', '').trim();
        const parent = indentStack[indentStack.length - 1];
        if (parent) {
          result.push('  '.repeat(indentStack.length) + selector.replace(parent + ' ', ''));
        } else {
          result.push(selector);
        }
        indentStack.push(selector);
      } else {
        result.push('  '.repeat(indentStack.length) + trimmed);
      }
    });

    setScss(result.join('\n'));
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-sm font-medium mb-1">CSS Code</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={css} onChange={(e) => setCss(e.target.value)} placeholder="Enter CSS code..." />
        </div>
        <div>
          <label className="block text-sm font-medium mb-1">SCSS Output</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={scss} readOnly placeholder="Converted SCSS appears here..." />
        </div>
      </div>
      <div className="flex gap-2">
        <button onClick={convert} className="btn-primary flex-1">Convert to SCSS</button>
        <CopyButton text={scss} />
      </div>
    </div>
  );
}

// ===== 6. JSON to YAML Converter =====
export function JSONToYAML() {
  const [json, setJson] = useState(`{
  "name": "John Doe",
  "age": 30,
  "email": "john@example.com",
  "address": {
    "street": "123 Main St",
    "city": "New York",
    "zip": "10001"
  },
  "hobbies": ["reading", "coding", "gaming"]
}`);
  const [yaml, setYaml] = useState('');

  const convert = () => {
    try {
      const data = JSON.parse(json);
      const toYaml = (obj, indent = 0) => {
        const pad = '  '.repeat(indent);
        let result = '';
        for (const [key, value] of Object.entries(obj)) {
          if (value === null) {
            result += `${pad}${key}: null\n`;
          } else if (typeof value === 'object' && !Array.isArray(value)) {
            result += `${pad}${key}:\n${toYaml(value, indent + 1)}`;
          } else if (Array.isArray(value)) {
            result += `${pad}${key}:\n`;
            value.forEach(item => {
              if (typeof item === 'object') {
                result += `${pad}  - \n${toYaml(item, indent + 2)}`;
              } else {
                result += `${pad}  - ${item}\n`;
              }
            });
          } else if (typeof value === 'string') {
            result += `${pad}${key}: "${value}"\n`;
          } else {
            result += `${pad}${key}: ${value}\n`;
          }
        }
        return result;
      };
      setYaml(toYaml(data));
    } catch (e) {
      setYaml('Invalid JSON: ' + e.message);
    }
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-sm font-medium mb-1">JSON</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={json} onChange={(e) => setJson(e.target.value)} placeholder="Enter JSON..." />
        </div>
        <div>
          <label className="block text-sm font-medium mb-1">YAML Output</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={yaml} readOnly placeholder="Converted YAML appears here..." />
        </div>
      </div>
      <div className="flex gap-2">
        <button onClick={convert} className="btn-primary flex-1">Convert to YAML</button>
        <CopyButton text={yaml} />
      </div>
    </div>
  );
}

// ===== 7. YAML to JSON Converter =====
export function YAMLToJSON() {
  const [yaml, setYaml] = useState(`name: "John Doe"
age: 30
email: "john@example.com"
address:
  street: "123 Main St"
  city: "New York"
  zip: "10001"
hobbies:
  - "reading"
  - "coding"
  - "gaming"`);
  const [json, setJson] = useState('');

  const convert = () => {
    try {
      const lines = yaml.split('\n');
      const result = {};
      const stack = [{ indent: -1, obj: result }];

      lines.forEach(line => {
        if (!line.trim() || line.trim().startsWith('#')) return;
        const indent = line.match(/^\s*/)[0].length;
        const content = line.trim();
        const isArrayItem = content.startsWith('- ');
        const cleanContent = isArrayItem ? content.slice(2) : content;
        const [key, ...valueParts] = cleanContent.split(':');
        const value = valueParts.join(':').trim();

        while (stack.length > 1 && indent <= stack[stack.length - 1].indent) {
          stack.pop();
        }

        const current = stack[stack.length - 1].obj;

        if (isArrayItem) {
          if (!current._array) current._array = [];
          if (value) {
            current._array.push(parseValue(value));
          } else {
            const newObj = {};
            current._array.push(newObj);
            stack.push({ indent, obj: newObj });
          }
        } else {
          if (value) {
            current[key.trim()] = parseValue(value);
          } else {
            const newObj = {};
            current[key.trim()] = newObj;
            stack.push({ indent, obj: newObj });
          }
        }
      });

      const cleanObj = (obj) => {
        if (Array.isArray(obj)) return obj.map(cleanObj);
        if (obj && typeof obj === 'object') {
          const { _array, ...rest } = obj;
          const cleaned = {};
          for (const [k, v] of Object.entries(rest)) {
            cleaned[k] = cleanObj(v);
          }
          if (_array) return cleaned._array || cleaned;
          return cleaned;
        }
        return obj;
      };

      setJson(JSON.stringify(cleanObj(result), null, 2));
    } catch (e) {
      setJson('Invalid YAML: ' + e.message);
    }
  };

  const parseValue = (val) => {
    if (val === 'null') return null;
    if (val === 'true') return true;
    if (val === 'false') return false;
    if (!isNaN(val) && val !== '') return Number(val);
    return val.replace(/^"|"$/g, '');
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-sm font-medium mb-1">YAML</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={yaml} onChange={(e) => setYaml(e.target.value)} placeholder="Enter YAML..." />
        </div>
        <div>
          <label className="block text-sm font-medium mb-1">JSON Output</label>
          <textarea className="input-field min-h-[300px] font-mono text-sm" value={json} readOnly placeholder="Converted JSON appears here..." />
        </div>
      </div>
      <div className="flex gap-2">
        <button onClick={convert} className="btn-primary flex-1">Convert to JSON</button>
        <CopyButton text={json} />
      </div>
    </div>
  );
}

// ===== 8. Background Remover =====
export function BackgroundRemover() {
  const [image, setImage] = useState(null);
  const [preview, setPreview] = useState('');
  const [processing, setProcessing] = useState(false);
  const [done, setDone] = useState(false);
  const fileInputRef = useRef(null);

  const handleFile = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      setImage(file);
      setPreview(reader.result);
      setDone(false);
    };
    reader.readAsDataURL(file);
  };

  const removeBg = () => {
    if (!image) return;
    setProcessing(true);
    setTimeout(() => {
      setProcessing(false);
      setDone(true);
    }, 2000);
  };

  return (
    <div className="space-y-4">
      <input ref={fileInputRef} type="file" accept="image/*" onChange={handleFile} className="hidden" />
      <button onClick={() => fileInputRef.current?.click()} className="btn-primary w-full">
        Choose Image
      </button>
      {preview && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="text-center">
            <label className="block text-sm font-medium mb-2">Original</label>
            <img src={preview} alt="Original" className="max-h-64 mx-auto rounded-lg border border-gray-300 dark:border-gray-600" />
          </div>
          <div className="text-center">
            <label className="block text-sm font-medium mb-2">Background Removed</label>
            <div className="max-h-64 mx-auto rounded-lg border border-gray-300 dark:border-gray-600 bg-[repeating-conic-gradient(#ccc_0%_25%,#fff_0%_50%)] bg-[length:20px_20px] flex items-center justify-center min-h-[200px]">
              {done ? (
                <img src={preview} alt="Processed" className="max-h-60 mix-blend-multiply" />
              ) : (
                <span className="text-gray-400">Processed image appears here</span>
              )}
            </div>
          </div>
        </div>
      )}
      {image && !done && (
        <button onClick={removeBg} disabled={processing} className="btn-secondary w-full">
          {processing ? 'Processing...' : 'Remove Background'}
        </button>
      )}
      {done && (
        <div className="card text-center p-4 bg-green-50 dark:bg-green-900/20 border-green-300 dark:border-green-700">
          <div className="text-2xl mb-2">OK</div>
          <p className="font-semibold mb-2">Background removed!</p>
          <p className="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Note: Browser me full background removal ke liye AI/ML API chahiye hoti hai.
            Ye demo version hai. Production ke liye remove.bg ya similar API use karein.
          </p>
          <a href="#" className="btn-primary inline-block">Download Image</a>
        </div>
      )}
    </div>
  );
}