import { useState } from 'react';
import CopyButton from '../common/CopyButton';

// ===== 1. Random Number Generator =====
export function RandomNumber() {
  const [min, setMin] = useState(1);
  const [max, setMax] = useState(100);
  const [result, setResult] = useState(null);

  const generate = () => {
    const minNum = Math.min(min, max);
    const maxNum = Math.max(min, max);
    setResult(Math.floor(Math.random() * (maxNum - minNum + 1)) + minNum);
  };

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-2 gap-4">
        <input type="number" className="input-field" placeholder="Min" value={min} onChange={(e) => setMin(parseInt(e.target.value) || 0)} />
        <input type="number" className="input-field" placeholder="Max" value={max} onChange={(e) => setMax(parseInt(e.target.value) || 0)} />
      </div>
      <button onClick={generate} className="btn-primary w-full">Generate Random Number</button>
      {result !== null && (
        <div className="card text-center p-6">
          <div className="text-5xl font-bold text-primary-600 dark:text-primary-400">{result}</div>
          <CopyButton text={String(result)} className="mt-3" />
        </div>
      )}
    </div>
  );
}

// ===== 2. Dice Roller =====
export function DiceRoller() {
  const [dice, setDice] = useState([1, 1]);
  const [rolling, setRolling] = useState(false);

  const roll = () => {
    setRolling(true);
    setTimeout(() => {
      setDice([Math.floor(Math.random() * 6) + 1, Math.floor(Math.random() * 6) + 1]);
      setRolling(false);
    }, 500);
  };

  const diceFaces = ['⚀', '⚁', '⚂', '⚃', '⚄', '⚅'];

  return (
    <div className="space-y-4 text-center">
      <div className="flex justify-center gap-8">
        {dice.map((value, i) => (
          <div key={i} className={`text-8xl transition-transform ${rolling ? 'animate-spin' : ''}`}>
            {diceFaces[value - 1]}
          </div>
        ))}
      </div>
      <div className="text-2xl font-bold">
        Total: {dice[0] + dice[1]}
      </div>
      <button onClick={roll} disabled={rolling} className="btn-primary w-full">
        {rolling ? 'Rolling...' : '🎲 Roll Dice'}
      </button>
    </div>
  );
}

// ===== 3. Coin Flip =====
export function CoinFlip() {
  const [result, setResult] = useState(null);
  const [flipping, setFlipping] = useState(false);
  const [history, setHistory] = useState([]);

  const flip = () => {
    setFlipping(true);
    setTimeout(() => {
      const outcome = Math.random() < 0.5 ? 'Heads' : 'Tails';
      setResult(outcome);
      setHistory(prev => [outcome, ...prev].slice(0, 10));
      setFlipping(false);
    }, 500);
  };

  return (
    <div className="space-y-4 text-center">
      <div className={`text-8xl transition-transform ${flipping ? 'animate-spin' : ''}`}>
        {result === 'Heads' ? '🪙' : result === 'Tails' ? '🪙' : '🪙'}
      </div>
      {result && (
        <div className="text-3xl font-bold text-primary-600 dark:text-primary-400">{result}!</div>
      )}
      <button onClick={flip} disabled={flipping} className="btn-primary w-full">
        {flipping ? 'Flipping...' : '🪙 Flip Coin'}
      </button>
      {history.length > 0 && (
        <div className="card">
          <div className="font-semibold mb-2">History:</div>
          <div className="flex flex-wrap gap-2 justify-center">
            {history.map((h, i) => (
              <span key={i} className={`px-3 py-1 rounded-full text-sm font-medium ${h === 'Heads' ? 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300' : 'bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300'}`}>
                {h}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

// ===== 4. Emoji Translator =====
export function EmojiTranslator() {
  const [text, setText] = useState('');

  const emojiMap = {
    'happy': '😊', 'sad': '😢', 'love': '❤️', 'heart': '❤️', 'cool': '😎',
    'laugh': '😂', 'funny': '😄', 'angry': '😠', 'cry': '😭', 'wow': '😮',
    'yes': '👍', 'no': '👎', 'ok': '👌', 'bye': '👋', 'hello': '👋',
    'hi': '👋', 'good': '👍', 'bad': '👎', 'great': '🌟', 'awesome': '🔥',
    'fire': '🔥', 'star': '⭐', 'sun': '☀️', 'moon': '🌙', 'rain': '🌧️',
    'snow': '❄️', 'cat': '🐱', 'dog': '🐶', 'bird': '🐦', 'fish': '🐟',
    'pizza': '🍕', 'burger': '🍔', 'cake': '🎂', 'coffee': '☕', 'tea': '🍵',
    'car': '🚗', 'plane': '✈️', 'rocket': '🚀', 'music': '🎵', 'game': '🎮',
    'book': '📚', 'phone': '📱', 'computer': '💻', 'money': '💰', 'gift': '🎁',
  };

  const translate = () => {
    return text.split(/\s+/).map(word => {
      const clean = word.toLowerCase().replace(/[^a-z]/g, '');
      return emojiMap[clean] || word;
    }).join(' ');
  };

  return (
    <div className="space-y-4">
      <textarea className="input-field min-h-[150px]" placeholder="Type text with words like happy, love, cool..." value={text} onChange={(e) => setText(e.target.value)} />
      <div className="flex items-start space-x-2">
        <textarea className="input-field min-h-[150px] text-2xl" value={translate()} readOnly placeholder="Emoji translation appears here..." />
        <CopyButton text={translate()} />
      </div>
    </div>
  );
}

