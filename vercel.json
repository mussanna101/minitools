{
  "rewrites": [
    { "source": "/tools/:name", "destination": "/tools/:name/index.html" },
    { "source": "/tools/:name/", "destination": "/tools/:name/index.html" },
    { "source": "/category/:name", "destination": "/category/:name/index.html" },
    { "source": "/category/:name/", "destination": "/category/:name/index.html" }
  ],
  "redirects": [
    { "source": "/tool/:name", "destination": "/tools/:name", "statusCode": 301 },
    { "source": "/tool/:name/", "destination": "/tools/:name", "statusCode": 301 }
  ]
}
