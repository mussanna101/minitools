{
  "name": "mini-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-og.mjs",
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-og.mjs && vite build && node scripts/prerender-static.mjs",
    "prerender": "node scripts/prerender-static.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "prerender:plugin": "node node_modules/vite/bin/vite.js build --config vite.config.prerender-plugin.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-prerender": "^1.0.8"
  }
}
